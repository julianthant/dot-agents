#!/bin/sh
# roadmap: regenerate this repo's roadmap page, keep it regenerating every 15s in the background, and open it.
# With arguments (--text, --board) it prints that view instead. `roadmap stop` ends the background refresh.
set -e
common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || { echo "roadmap: run inside a git repo" >&2; exit 1; }
repo=$(dirname "$common")
ledger="$HOME/.concord-ledger/$(basename "$repo")"
[ -d "$ledger" ] || { echo "roadmap: no ledger at $ledger" >&2; exit 1; }
export CONCORD_TELEMETRY_DISABLED=1 CONCORD_NO_UPDATE_CHECK=1 CONCORD_REPO_ROOT="$ledger"
script="$HOME/.agents/skills/dev-auto/scripts/roadmap.py"
if [ "${1:-}" = stop ]; then
	exec python3 "$script" --stop-refresh --repo "$repo"
fi
[ $# -gt 0 ] && exec python3 "$script" "$@" --repo "$repo"
python3 "$script" --start-refresh --repo "$repo"
open "$ledger/roadmap.html"
