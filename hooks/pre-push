#!/bin/sh
# Refuse pushes unrelated to, or too far ahead of, origin/staging.
max=${PUSH_MAX_AHEAD:-200}
zero=0000000000000000000000000000000000000000
base=refs/remotes/origin/staging
if ! git rev-parse --verify -q "$base" >/dev/null; then
	echo "pre-push: origin/staging not found, skipping checks"
	exit 0
fi
rc=0
while read -r local_ref local_sha _ _; do
	[ "$local_sha" = "$zero" ] && continue
	case $local_ref in refs/tags/*) continue ;; esac
	if ! git merge-base "$local_sha" "$base" >/dev/null 2>&1; then
		echo "pre-push: $local_ref shares no history with origin/staging" >&2
		rc=1
		continue
	fi
	ahead=$(git rev-list --count "$base..$local_sha")
	echo "pre-push: $local_ref is $ahead commits ahead of origin/staging"
	if [ "$ahead" -gt "$max" ]; then
		echo "pre-push: more than $max commits ahead, refusing" >&2
		rc=1
	fi
done
exit $rc
